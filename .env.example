# Copy to .env and adjust.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:###@localhost:5432/diagnostic_db

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Shared secret used to sign/verify payment webhooks (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Probability (0..1) that a simulated payment succeeds when no outcome is forced
SIMULATED_PAYMENT_SUCCESS_RATE=0.8

# Booking rules
BOOKING_MAX_DAYS_AHEAD=90
